+static std::string getUniqueSpblobHandle(const userid_t user_id) {
+	const std::string path = "/data/system_de/" + std::to_string(user_id) + "/spblob";
+	DIR* dir = opendir(path.c_str());
+	if (dir == nullptr) {
+		fprintf(stderr, "Can't open spblob directory '%s': %s\n", path.c_str(), strerror(errno));
+		return "";
+	}
+
+	std::string handle;
+	while (dirent* entry = readdir(dir)) {
+		const std::string name = entry->d_name;
+		constexpr char suffix[] = ".spblob";
+		if (name.size() <= sizeof(suffix) - 1 ||
+			name.compare(name.size() - (sizeof(suffix) - 1), sizeof(suffix) - 1, suffix) != 0)
+			continue;
+
+		const std::string candidate = name.substr(0, name.size() - (sizeof(suffix) - 1));
+		if (!std::all_of(candidate.begin(), candidate.end(), [](unsigned char c) { return isxdigit(c); }))
+			continue;
+		if (!handle.empty() && handle != candidate) {
+			fprintf(stderr, "Multiple synthetic-password handles found for user %d\n", user_id);
+			closedir(dir);
+			return "";
+		}
+		handle = candidate;
+	}
+	closedir(dir);
+	if (!handle.empty())
+		fprintf(stderr, "Using unique spblob handle '%s' for user %d\n", handle.c_str(), user_id);
+	return handle;
+}
