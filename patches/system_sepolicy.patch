diff --git a/private/recovery.te b/private/recovery.te
index 2dba93b..c137e0c 100644
--- a/private/recovery.te
+++ b/private/recovery.te
@@ -3,6 +3,16 @@ typeattribute recovery coredomain;
 # The allow rules are only included in the recovery policy.
 # Otherwise recovery is only allowed the domain rules.
 recovery_only(`
+  # TWRP links vold into recovery, but fscrypt_prepare_user_storage delegates
+  # directory relabeling to this helper. Run it in its normal confined domain.
+  # Ramdisk executables are rootfs-labeled; FsCrypt selects the destination
+  # context explicitly through the ForkExecvp context parameter.
+  domain_trans(recovery, rootfs, vold_prepare_subdirs)
+  allow recovery self:process setexec;
+  set_prop(recovery, twrp_prop)
+  allow vold_prepare_subdirs recovery:fd use;
+  allow vold_prepare_subdirs recovery:fifo_file { read write };
+
   # Reboot the device
   set_prop(recovery, powerctl_prop)
 
@@ -47,4 +57,29 @@ recovery_only(`
 
   # Needed to read bootconfig parameters through libfs_mgr
   allow recovery proc_bootconfig:file r_file_perms;
+
+  # TWRP decrypts metadata encryption in-process via keystore2.
+  # Both run as recovery, so they need the vold keystore2 namespace.
+  # Recovery also copies the Android keystore database into tmpfs so the
+  # recovery keystore2 instance can unwrap synthetic-password keys.
+  set_prop(recovery, restorecon_prop)
+  allow recovery keystore_data_file:dir r_dir_perms;
+  allow recovery keystore_data_file:file r_file_perms;
+  allow recovery locksettings_key:keystore2_key {
+    get_info
+    req_forced_op
+    use
+  };
+  allow recovery vold_key:keystore2_key {
+    convert_storage_key_to_ephemeral
+    delete
+    get_info
+    manage_blob
+    rebind
+    req_forced_op
+    update
+    use
+  };
+  get_prop(recovery, vendor_security_patch_level_prop)
+  get_prop(recovery, keystore_config_prop)
 ')
