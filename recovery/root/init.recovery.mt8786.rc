import /init.decrypt.rc
import /vibrator-clove.rc

on init
    # 1. Base Hardware & Bus Drivers
    insmod /lib/modules/spi-mt65xx.ko
    insmod /lib/modules/sspm_v1.ko

    # 2. Power & Thermal Infrastructure
    insmod /lib/modules/MTK_INTERNAL_SPM.ko
    insmod /lib/modules/mediatek_static_power.ko
    insmod /lib/modules/Upower.ko
    insmod /lib/modules/mtk_ppm_v3.ko
    insmod /lib/modules/thermal_monitor.ko

    # 3. Dynamic Frequency & Performance
    insmod /lib/modules/mtk-dvfsrc-helper.ko
    insmod /lib/modules/mtk_gpufreq_mt6768.ko
    insmod /lib/modules/mtk_gpufreq_wrapper_legacy.ko
    insmod /lib/modules/mtk_gpu_hal.ko
    insmod /lib/modules/connadp.ko

    # 4. Battery & Power Throttling
    insmod /lib/modules/mtk_power_gs_v1.ko
    insmod /lib/modules/mtk_mdpm_v1.ko
    insmod /lib/modules/mtk_pbm.ko
    insmod /lib/modules/mtk_dynamic_loading_throttling.ko
    insmod /lib/modules/mtk_battery_oc_throttling.ko
    insmod /lib/modules/mtk_low_battery_throttling.ko
    insmod /lib/modules/hqsysfs.ko

    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 1

on post-fs
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk1boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk1boot1 /dev/block/platform/bootdevice/by-name/preloader_b
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_a
    symlink /dev/block/mmcblk1boot1 /dev/block/by-name/preloader_b

    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils

    start boot-hal-1-2

on fs
    write /sys/class/udc/musb-hdrc/device/cmode 2
    start adbd

    # SCP + touch chain intentionally NOT auto-loaded: scp.ko is
    # confirmed to hang the whole init action queue in recovery.
    # Load manually after boot: adb shell sh /sbin/load_touch.sh

on boot
    start health-hal-2-1
