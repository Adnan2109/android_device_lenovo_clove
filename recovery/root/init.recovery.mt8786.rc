on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller musb-hdrc
    setprop sys.usb.ffs.aio_compat 0

on post-fs
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/by-name/preloader_b
    write /sys/module/firmware_class/parameters/path /vendor/firmware
    exec_start lenovo_touch_loader
    # recovery is a coredomain and must not own /dev/vndbinder. Stock
    # Beanpod Keymaster 4.1 talks HIDL via hwservicemanager.
    stop vndservicemanager
    mkdir /persist 0771 system system
    mkdir /mnt/vendor/persist 0771 system system
    mkdir /data/vendor/thh 0755 system system
    mkdir /data/vendor/thh/system 0755 system system
    mkdir /data/vendor/thh/ta 0755 system system
    mkdir /data/vendor/key_provisioning 0755 system system
    mount ext4 /dev/block/by-name/persist /persist rw wait
    symlink /persist /mnt/vendor/persist
    chmod 0660 /dev/teei_client
    chmod 0660 /dev/teei_config
    chmod 0660 /dev/tz_vfs
    chmod 0660 /dev/ut_keymaster
    chmod 0660 /dev/rpmb0
    chmod 0660 /dev/mmcblk0rpmb
    chmod 0666 /dev/isee_tee0
    # Keep these as init services. Backgrounding them from a shell
    # gets them killed when the oneshot exits.
    start teei_daemon
    exec_start teei_wait_unlock
    start beanpod_keymaster
    start beanpod_gatekeeper

on late-init
    stop vndservicemanager

service lenovo_touch_loader /system/bin/lenovo_module_loader /system/etc/lenovo-modules.touch-shim
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

service teei_daemon /system/bin/teei_daemon -r 020b0000000000000000000000000000 -r 020f0000000000000000000000000000 -r 06090000000000000000000000000000 -r 05120000000000000000000000000000 -r 40188311faf343488db888ad39496f9a -r 07060000000000000000000000007169 -r 4be4f7dc1f2c11e5b5f7727283247c7f -r 9073f03a9618383bb1856eb3f990babd -r 08050000000000000000000000003419 -r 5020170115e016302017012521300000 -r 0f5eed3c3b5a47afacca69a84bf0efad -r 07407000000000000000000000000000 -r 05160000000000000000000000000000 -r 91dba524a6e24909acc48abd7163121a -r 08070000000000000000000000008270 -r 09080000000000000000000000009381 -t 08030000000000000000000000000000 -t 85f630e0f0964c5fa2cc268ce04e3da3 -t 98fb95bcb4bf42d26473eae48690d7ea -t 7b66512021214487ba710a51d7ea78fe -t 09010000000000000000000000000000
    disabled
    user root
    group root
    seclabel u:r:recovery:s0

service teei_wait_unlock /system/bin/sh /system/bin/teei_wait_unlock.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

service beanpod_keymaster /system/bin/sh /system/bin/beanpod_keymaster.sh
    disabled
    user root
    group root
    seclabel u:r:recovery:s0
    stdio_to_kmsg

service beanpod_gatekeeper /system/bin/sh /system/bin/beanpod_gatekeeper.sh
    disabled
    user root
    group root
    seclabel u:r:recovery:s0
    stdio_to_kmsg
