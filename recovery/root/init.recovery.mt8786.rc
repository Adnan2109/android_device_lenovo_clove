import /init.decrypt.rc
import /vibrator-clove.rc

# Modules & Services
on init
    # 1. Base Hardware & Bus Drivers
    insmod /vendor/lib/modules/spi-mt65xx.ko
    insmod /vendor/lib/modules/touch_common.ko
    insmod /vendor/lib/modules/hwmon.ko
    insmod /vendor/lib/modules/sspm_v1.ko

    # 2. Power & Thermal Infrastructure
    insmod /vendor/lib/modules/MTK_INTERNAL_SPM.ko
    insmod /vendor/lib/modules/mediatek_static_power.ko
    insmod /vendor/lib/modules/Upower.ko
    insmod /vendor/lib/modules/mtk_ppm_v3.ko
    insmod /vendor/lib/modules/thermal_monitor.ko

    # 3. Dynamic Frequency & Performance
    insmod /vendor/lib/modules/mtk-dvfsrc-helper.ko
    insmod /vendor/lib/modules/mtk_gpufreq_mt6768.ko
    insmod /vendor/lib/modules/mtk_gpufreq_wrapper_legacy.ko
    insmod /vendor/lib/modules/mtk_gpu_hal.ko
    insmod /vendor/lib/modules/connadp.ko

    # 3.5 SCP - moved here since it depends on MTK_INTERNAL_SPM and
    # mtk-dvfsrc-helper (confirmed via modinfo) - must load after both
    insmod /vendor/lib/modules/scp.ko

    # 4. Battery & Power Throttling
    insmod /vendor/lib/modules/mtk_power_gs_v1.ko
    insmod /vendor/lib/modules/mtk_mdpm_v1.ko
    insmod /vendor/lib/modules/mtk_pbm.ko
    insmod /vendor/lib/modules/mtk_dynamic_loading_throttling.ko
    insmod /vendor/lib/modules/mtk_battery_oc_throttling.ko
    insmod /vendor/lib/modules/mtk_low_battery_throttling.ko
    insmod /lib/modules/battery_id_adc.ko
    insmod /lib/modules/mt6358_battery.ko
    insmod /lib/modules/hq_fg_class.ko
    insmod /lib/modules/mm8013.ko
    insmod /lib/modules/mtk_battery_manager.ko

    # 5. Sensor Hub
    insmod /vendor/lib/modules/sensorHub.ko
    insmod /vendor/lib/modules/alsps_common.ko
    insmod /vendor/lib/modules/alspshub.ko

    # 6. Thermal (CPU temp - registers mtktscpu zone)
    insmod /vendor/lib/modules/mtk_bp_thl.ko
    insmod /vendor/lib/modules/mtk_cpu_power_throttling.ko

    # 7. OEM Sysfs & Touch Driver
    insmod /vendor/lib/modules/tpd_notify.ko
    insmod /vendor/lib/modules/hqsysfs.ko
    # ILITEK SPI touch (primary) - requires SCP chain
    insmod /vendor/lib/modules/ilitek_spi.ko
    # Goodix GT1151 touch (fallback - minimal deps)
    insmod /vendor/lib/modules/gt1151.ko
    # Additional touch drivers (chipone/focaltech fallbacks)
    insmod /vendor/lib/modules/chipone.ko
    insmod /vendor/lib/modules/chipone9916.ko

    # USB config for MTK musb controller
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 1

on post-fs
    # Support A/B feature for EMMC and UFS boot region
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk1boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk1boot1 /dev/block/platform/bootdevice/by-name/preloader_b
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_a
    symlink /dev/block/mmcblk1boot1 /dev/block/by-name/preloader_b

    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils

    start boot-hal-1-2

on fs
    # USB: set CDP mode and start adbd for ADB access in recovery
    write /sys/class/udc/musb-hdrc/device/cmode 2
    start adbd

on boot
    start health-hal-2-1
